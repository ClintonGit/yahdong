# ── Database (external PostgreSQL) ───────────────────────────────────────────
# URL-encode special chars in password: ? → %3F, $ → %24, ] → %5D, % → %25
DATABASE_URL=postgresql://<user>:<encoded-password>@168.144.128.246:5432/yahdong

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate each independently: openssl rand -base64 48
# JWT_REFRESH_SECRET MUST be different from JWT_SECRET — if access-secret leaks,
# the refresh token must remain unguessable.
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. REQUIRED in production — bootstrap fails if unset.
CORS_ORIGINS=https://yahdong.commsk.dev

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
