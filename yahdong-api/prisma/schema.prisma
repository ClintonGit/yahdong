generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  admin
  member
}

enum ProjectRole {
  owner
  member
  viewer
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgMembers      OrgMember[]
  projectMembers  ProjectMember[]
  taskAssignments TaskAssignee[]
  createdTasks    Task[]          @relation("creator")
  comments        Comment[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Organization {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   OrgMember[]
  projects  Project[]
}

model OrgMember {
  orgId     String
  userId    String
  role      OrgRole      @default(member)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@id([orgId, userId])
  @@index([userId])
}

model Project {
  id          String          @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  color       String?
  coverImage  String?
  isPublic    Boolean         @default(false)
  shareToken  String?         @unique
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  org         Organization    @relation(fields: [orgId], references: [id])
  members     ProjectMember[]
  statuses    TaskStatus[]
  tasks       Task[]
  invites     ProjectInvite[]
  labels      Label[]

  @@unique([orgId, slug])
  @@index([orgId, deletedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(member)
  starred   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
  @@index([userId, projectId])
}

model ProjectInvite {
  id        String      @id @default(cuid())
  projectId String
  token     String      @unique
  email     String?
  role      ProjectRole @default(member)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id])

  @@index([projectId, email])
}

model TaskStatus {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String
  order     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id             String          @id @default(cuid())
  projectId      String
  title          String
  description    String?
  statusId       String
  priority       TaskPriority    @default(medium)
  sprintId       String?
  startDate      DateTime?
  dueDate        DateTime?
  coverImage     String?
  coverColor     String?
  order          Float
  createdBy      String
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id])
  status         TaskStatus      @relation(fields: [statusId], references: [id])
  creator        User            @relation("creator", fields: [createdBy], references: [id])
  comments       Comment[]
  labels         TaskLabel[]
  checklistItems ChecklistItem[]
  assignees      TaskAssignee[]
  notifications  Notification[]

  @@index([projectId])
  @@index([statusId])
  @@index([projectId, statusId])
  @@index([projectId, deletedAt])
  @@index([dueDate])
  @@index([startDate])
}

model Label {
  id        String      @id @default(cuid())
  projectId String
  name      String
  color     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id])
  tasks     TaskLabel[]

  @@index([projectId])
}

model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id])
  label     Label    @relation(fields: [labelId], references: [id])

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  checked   Boolean  @default(false)
  order     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Comment {
  id            String         @id @default(cuid())
  taskId        String
  userId        String
  body          String
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  task          Task           @relation(fields: [taskId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@index([taskId])
  @@index([userId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  taskId    String
  commentId String?
  type      String    @default("mention")
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([taskId])
  @@index([commentId])
}
